    {
      "span_id": "SPAN-01-CHILD-RECEIPT-REGISTRATION-STORAGE",
      "purpose": "Introduce private child validator admission receipt storage and registration API",
      "line_range": "413-436",
      "start_byte_offset": 14401,
      "end_byte_offset": 15598,
      "byte_length": 1197,
      "existing_context_sha256": "B153800FB5FFADE8C8A95D1B8F263EB970FC97BB94BFA2ADDA14151F68F5C473",
      "proposed_addition": [
        "// Gate05-R26 / M04: Private operator-owned READ_ONLY child validator admission receipt slot",
        "private static OperatorStartupAdmissionReceipt? _activeChildValidatorReceipt = null;",
        "public static OperatorStartupAdmissionReceipt? ActiveChildValidatorReceipt => _activeChildValidatorReceipt;",
        "",
        "internal static bool TryRegisterChildValidatorReceipt(OperatorStartupAdmissionReceipt childReceipt)",
        "{",
        "    if (childReceipt == null || !childReceipt.IsValid()) return false;",
        "    if (!string.Equals(childReceipt.Snapshot.Role, \"READ_ONLY\", StringComparison.Ordinal)) return false;",
        "    lock (_configLock)",
        "    {",
        "        if (_activeStartupConfig == null || !_operatorConfigSealed) return false;",
        "        if (_activeChildValidatorReceipt != null) return false; // Single-active; reject overwrite",
        "        // Verify executable and content profile match parent SIMULATION worker",
        "        if (!string.Equals(childReceipt.Snapshot.AdmittedValidatorExecutablePath, _activeStartupConfig.AdmittedValidatorExecutablePath, StringComparison.OrdinalIgnoreCase)) return false;",
        "        if (!string.Equals(childReceipt.Snapshot.AdmittedValidatorExecutableSha256, _activeStartupConfig.AdmittedValidatorExecutableSha256, StringComparison.OrdinalIgnoreCase)) return false;",
        "        if (!string.Equals(childReceipt.Snapshot.ExpectedContentProfileFingerprint, _activeStartupConfig.ExpectedContentProfileFingerprint, StringComparison.Ordinal)) return false;",
        "        _activeChildValidatorReceipt = childReceipt;",
        "        return true;",
        "    }",
        "}",
        "",
        "internal static void RevokeChildValidatorReceipt()",
        "{",
        "    lock (_configLock)",
        "    {",
        "        _activeChildValidatorReceipt = null;",
        "    }",
        "}"
      ]
    },
    {
      "span_id": "SPAN-02-HANDLE-LAUNCH-OPERATOR-VALIDATOR-CONSUMER",
      "purpose": "Update HandleLaunchOperatorValidator to consume registered child receipt via closed launch plan builder",
      "line_range": "2237-2281",
      "start_byte_offset": 101495,
      "end_byte_offset": 103837,
      "byte_length": 2342,
      "existing_context_sha256": "1EF1BAC86DBC663557B882E41419CDA150754D00F44C9C3B26A377120216DD54",
      "proposed_addition": [
        "// Gate05-R26 / M04: Require admitted child validator receipt strictly (Fail-Closed)",
        "if (_activeStartupConfig == null || _activeAdmissionReceipt == null)",
        "{",
        "    RevokeReadiness(\"No admitted operator startup configuration active for parent worker (Fail-Closed).\");",
        "    return \"ERROR: No admitted operator startup configuration active for parent worker.\";",
        "}",
        "if (_activeChildValidatorReceipt == null)",
        "{",
        "    RevokeReadiness(\"No admitted child validator startup configuration registered (Fail-Closed).\");",
        "    return \"ERROR: No admitted child validator startup configuration registered.\";",
        "}",
        "",
        "var planResult = ChildValidatorLaunchPlanBuilder.BuildLaunchPlan(",
        "    _activeAdmissionReceipt,",
        "    _activeChildValidatorReceipt,",
        "    currentValidatorTask,",
        "    currentValidatorTaskPath);",
        "if (!planResult.isValid || planResult.plan == null)",
        "{",
        "    RevokeReadiness($\"Failed to construct closed child validator launch plan: {planResult.error}\");",
        "    return $\"ERROR: Failed to construct child validator launch plan: {planResult.error}\";",
        "}",
        "var plan = planResult.plan;",
        "",
        "// Preflight check BEFORE Process.Start: File existence and SHA256 match",
        "var preflight = ExecutableAdmissionHelper.VerifyAdmittedExecutable(plan.ExecutablePath, plan.ExecutableExpectedSha256);",
        "if (!preflight.isValid)",
        "{",
        "    RevokeReadiness($\"Preflight executable admission check failed before Process.Start: {preflight.error}\");",
        "    return $\"ERROR: Preflight executable admission check failed: {preflight.error}\";",
        "}",
        "",
        "string childArgs = string.Join(\" \", plan.FormattedArgumentTokens);",
        "",
        "var psi = new ProcessStartInfo",
        "{",
        "    FileName = plan.ExecutablePath,",
        "    Arguments = childArgs,",
        "    CreateNoWindow = true,",
        "    UseShellExecute = false",
        "};",
        "if (!string.IsNullOrWhiteSpace(plan.WorkingDirectory) && Directory.Exists(plan.WorkingDirectory))",
        "{",
        "    psi.WorkingDirectory = plan.WorkingDirectory;",
        "}"
      ]
    },
