    public class BridgeRequest
    {
        public string Command = "";
        public string Argument = "";
        public TaskCompletionSource<string> ResponseTcs = new TaskCompletionSource<string>();
        public DateTime QueuedTime = DateTime.UtcNow;
    }

    public enum WorkerLifecycleState
    {
        NO_GAME,
        LOAD_REQUESTED,
        VALIDATING,
        LOADING,
        READY,
        LOAD_FAILED,
        SHUTTING_DOWN
    }

    public enum SemanticApprovalState
    {
        NONE,
        LOADED_UNTRUSTED,
        VALIDATION_REQUIRED,
        VALIDATION_FAILED,
        INPUT_VALIDATED,
        RESULT_SEALED,
        STAGED_PENDING_VALIDATION,
        STAGED_VALIDATED,
        ARTIFACT_APPROVED
    }

    public class WorkerBridgeComponent : MonoBehaviour
    {
        public static string? CustomSaveDataPathOverride = null;

        // Gate05-R18 / Gate05-R20: Sealed operator-owned startup configuration and admission receipt (M01..M03)
        private static OperatorStartupAdmissionReceipt? _activeAdmissionReceipt = null;
        private static OperatorStartupConfigSnapshot? _activeStartupConfig = null;
        private static bool _operatorConfigSealed = false;
        private static readonly object _configLock = new object();

        public static OperatorStartupAdmissionReceipt? ActiveAdmissionReceipt => _activeAdmissionReceipt;
        public static OperatorStartupConfigSnapshot? ActiveStartupConfig => _activeStartupConfig;

        internal static bool TryInstallOperatorStartupConfig(OperatorStartupAdmissionReceipt receipt)
        {
            if (receipt == null || !receipt.IsValid()) return false;
            lock (_configLock)
            {
                if (_operatorConfigSealed || _activeAdmissionReceipt != null)
                {
                    return false;
                }
                _activeAdmissionReceipt = receipt;
                _activeStartupConfig = receipt.Snapshot;
                _operatorConfigSealed = true;
                return true;
            }
        }

        public static string SafeSaveDataFolderPath
        {
            get
            {
